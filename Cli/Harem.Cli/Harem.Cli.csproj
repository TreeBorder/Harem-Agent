<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>harem-cli</AssemblyName>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeAllContentForSelfExtractor>true</IncludeAllContentForSelfExtractor>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.*" />
        <PackageReference Include="Spectre.Console.Cli" Version="0.*" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.*" />
    </ItemGroup>

</Project>
